      "scenes": ["overload", "clock-out"],
      "durationMin": 12,
      "visual": {
        "kind": "tense-release-discs",
        "tint": { "overload": "clay-vs-sand", "clock-out": "night-sand-tungsten" },
        "forbid": ["ground-stairs", "box-square"]
