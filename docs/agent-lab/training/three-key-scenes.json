      "breath": { "pattern": "tense-5-release-8", "cycleSec": 13, "force": "70-percent", "noHoldBreath": true },
      "eeg": { "arousal": "how clenched the small disc is", "calm": "how fully the large disc blooms", "focus": "which pair is lit" },
      "bodyOrder": ["hands", "forearms", "shoulders", "face", "belly", "legs"],
      "phases": [
        {
          "name": "安顿",
          "minutes": 2,
          "instruction": "坐好或躺下，双脚踩实。只有一个动作：用力绷紧 5 秒，然后一下子松掉。我们先从手开始。",
          "cues": [
            { "atSec": 30, "text": "只用七成力。不要憋气。" },
            { "atSec": 70, "text": "等一下我会数五下。松开的那一下，才是练习。" }
          ],
          "sceneExtra": { "clock-out": "这是把白天攒在肩膀里的力交出去，不是再练一轮。" }
        },
        {
          "name": "紧-松循环",
          "minutes": 8,
          "instruction": "握紧拳头，五、四、三、二、一——松开，感受那股暖流。接下来是小臂、肩膀、脸、腹部、腿。一组一组来。",
          "cues": [
            { "atSec": 0, "text": "手。握紧——五、四、三、二、一。松开。" },
            { "atSec": 80, "text": "小臂。同样，七成力。" },
            { "atSec": 160, "text": "肩膀，往耳朵方向耸一下，然后放下来。" },
            { "atSec": 240, "text": "脸。轻轻皱一下，再松开下巴。" },
            { "atSec": 320, "text": "腹部，微微收，再交给椅背。" },
            { "atSec": 400, "text": "腿。脚尖绷一下，再像陷进地板。" }
          ],
          "adaptive": [{ "when": "arousal>70 and focus>70", "text": "可以再轻一点。松开比绷紧重要。" }]
        },
        {
          "name": "整体沉静",
          "minutes": 2,
          "instruction": "现在整个身体都松过了。安静坐着，感受和十二分钟前有什么不同。",
          "cues": [{ "atSec": 50, "text": "不用评价松得够不够。差别本身就够了。" }]
        }
      ]
    },
    {
