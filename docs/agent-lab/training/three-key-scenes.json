      "name": "4-7-8 生理刹车",
      "scenes": ["overload"],
      "durationMin": 8,
      "visual": { "kind": "exhale-triangle", "dust": "clay-tabs", "bg": [20, 16, 18], "glow": [184, 242, 201], "forbid": ["meeting-copy", "box-square"] },
      "breath": { "pattern": "4-7-8", "cycleSec": 19, "altIfHoldAverse": "4-0-8" },
