  "modules": [
    {
      "planId": "breath-box",
      "name": "箱式呼吸 · 专注前奏",
      "scenes": ["clock-in"],
      "durationMin": 6,
      "visual": { "kind": "box-square", "bg": [18, 28, 24], "glow": [245, 229, 107], "forbid": ["generic-rings", "bloom-press", "ground-stairs"] },
      "breath": { "pattern": "box-4-4-4-4", "cycleSec": 16 },
      "eeg": { "focus": "corner alignment", "calm": "inner fill", "arousal": "jitter, never faster edges" },
      "phases": [
        {
          "name": "坐姿校准",
          "minutes": 1,
          "instruction": "找一个能靠住的地方坐下。双脚平放。想象头顶有一根线轻轻向上提。看一眼你等下要做的事，然后把目光收回来。",
          "cues": [
            { "atSec": 20, "text": "双脚踩实。肩膀不用端着。" },
            { "atSec": 40, "text": "屏幕上会有一个正方形。你只跟着它的边走。" }
          ]
        },
        {
          "name": "四方循环",
          "minutes": 4,
          "instruction": "吸气四拍——停四拍——呼气四拍——停四拍。像在空气中画一个正方形。注意力跑了，就带回正在长出来的那条边。",
          "cues": [
            { "atSec": 4, "text": "吸。" },
            { "atSec": 20, "text": "停。边还在。" },
            { "atSec": 36, "text": "呼。把气慢慢放完。" },
            { "atSec": 52, "text": "再停一下。下一条边会自己来。" }
          ],
          "adaptive": [
            { "when": "focus<40 for 8s", "text": "注意力跑了，就带回这条边。" },
            { "when": "arousal>75 for 8s", "text": "边可以画慢一点，不必用力。" }
          ]
        },
        {
          "name": "定锚",
          "minutes": 1,
          "instruction": "最后一次四方呼吸。睁开眼之前，对自己说：接下来这段时间，只有这一件事。",
          "cues": [{ "atSec": 40, "text": "方块可以放下了。你带着这个点，开始工作。" }]
        }
      ]
    },
    {
      "planId": "walk-mindful",
      "name": "正念行走",
      "scenes": ["clock-in"],
      "durationMin": 10,
      "visual": { "kind": "footpath-dots", "bg": [28, 24, 36], "glow": [213, 208, 224], "forbid": ["box-square", "bloom-press"], "safety": "do not require staring while in traffic" },
      "breath": { "pattern": "steps-3-3", "spoken": "inhale 3 steps, exhale 3 steps" },
      "eeg": { "focus": "steps stay on the path", "calm": "fog softness", "arousal": "step jitter" },
      "phases": [
        {
          "name": "起步",
          "minutes": 2,
          "instruction": "用平时的速度走。先注意脚底：脚跟落地、重心前移、脚尖离地。只是注意，不用改变什么。",
          "cues": [
            { "atSec": 25, "text": "先看路，再看一眼屏幕就够了。" },
            { "atSec": 70, "text": "脚跟。脚心。脚尖。下一步也一样。" }
          ]
        },
        {
          "name": "节拍",
          "minutes": 5,
          "instruction": "让呼吸跟上脚步。吸气走三步，呼气走三步。走神了没关系，回到脚底的触感就好。",
          "cues": [
            { "atSec": 20, "text": "吸——一步、两步、三步。" },
            { "atSec": 50, "text": "呼——一步、两步、三步。" },
            { "atSec": 120, "text": "走神了就回脚底。路还在。" }
          ],
          "adaptive": [{ "when": "focus<40 for 8s", "text": "不用走得更整齐。回到这一步就好。" }]
        },
        {
          "name": "打开",
          "minutes": 3,
          "instruction": "把注意力从脚底扩大到周围：风、声音、光线。你不是在路过这条街，你是在这条街上。",
          "cues": [
            { "atSec": 30, "text": "脸上的风，或空调。" },
            { "atSec": 90, "text": "带着这个步子，走到你要开始的那张桌子。" }
          ]
        }
      ]
    },
    {
      "planId": "breath-bloom",
      "name": "呼吸之花",
      "scenes": ["clock-in"],
      "durationMin": 6,
      "interactive": "bloom",
      "visual": { "kind": "bloom-flower", "tint": "butter-coral", "bg": [22, 18, 16], "glow": [245, 200, 150], "forbid": ["default-mint-only"], "note": "Existing BreathBloom must read EEG for quality; pace stays 4-4." },
      "breath": { "pattern": "press-4-release-4", "cycleSec": 8 },
      "eeg": { "focus": "petal angle evenness", "calm": "outer glow", "arousal": "core jitter" },
      "phases": [
        {
          "name": "认识你的花",
          "minutes": 1,
          "instruction": "屏幕中央有一朵尚未开放的花。用手指按住它——花瓣随吸气绽开；松开，随呼气合拢。先试一次。",
          "cues": [
            { "atSec": 15, "text": "按住，吸。" },
            { "atSec": 35, "text": "松开，呼。" },
            { "atSec": 50, "text": "你的手就是节拍。花只是跟着你。" }
          ]
        },
        {
          "name": "同步循环",
          "minutes": 4,
          "instruction": "跟着花的节奏。按住，吸——花瓣开到最大；松开，呼——看它收回。你的呼吸有多慢，花就开得多慢。",
          "cues": [],
          "adaptive": [{ "when": "press too short or too frequent", "text": "按满四拍再放。不必用力。" }]
        },
        {
          "name": "放手",
          "minutes": 1,
          "instruction": "最后一次让花绽开。然后把手放下，只看着它自己开合——你的呼吸已经记住了这个节奏。",
          "cues": [{ "atSec": 35, "text": "花可以自己开了。你带着这个节奏，去第一件事。" }]
        }
      ]
    },
    {
      "planId": "grounding-54321",
      "name": "感官着陆 5-4-3-2-1",
      "scenes": ["overload"],
      "durationMin": 5,
      "visual": { "kind": "ground-stairs", "bg": [20, 16, 14], "glow": [255, 107, 74], "land": [168, 191, 176], "forbid": ["box-square", "exhale-triangle"] },
      "breath": { "pattern": "none-until-last", "lastExhaleSec": 8 },
      "eeg": { "arousal": "tab fragments behind stairs", "calm": "sage ground", "focus": "current stair clarity" },
      "phases": [
        {
          "name": "5 样东西 · 看",
          "minutes": 1,
          "instruction": "环顾四周，在心里说出你看到的 5 样东西。不用特别，桌角、水杯、光斑都可以。慢慢说，一样一样来。",
          "cues": [
            { "atSec": 12, "text": "第一样。看见它。" },
            { "atSec": 24, "text": "第二样。" },
            { "atSec": 36, "text": "第三样。" },
            { "atSec": 48, "text": "第四样。" },
            { "atSec": 56, "text": "第五样。它们都在这儿。" }
          ]
        },
        {
          "name": "4 种触感 · 摸",
          "minutes": 1,
          "instruction": "找到 4 种触感：衣料、桌面的凉、脚底的支撑、手心的温度。每种停几秒。",
          "cues": [
            { "atSec": 10, "text": "衣料。" },
            { "atSec": 25, "text": "桌面，或扶手。" },
            { "atSec": 40, "text": "脚底踩着的地方。" },
            { "atSec": 52, "text": "手心。热的或凉的，都算。" }
          ]
        },
        {
          "name": "3 种声音 · 听",
          "minutes": 1,
          "instruction": "闭上眼，找出周围 3 种声音。远处的也算，自己的呼吸也算。只是听，不评价。",
          "cues": [
            { "atSec": 12, "text": "第一种声音。" },
            { "atSec": 32, "text": "再远一点的。" },
            { "atSec": 50, "text": "呼吸也可以是第三种。" }
          ]
        },
        {
          "name": "2 种气味 · 1 口呼吸",
          "minutes": 2,
          "instruction": "留意 2 种气味，没有就回想一种。然后做一次又慢又长的呼气。你已经回到此时此地了。",
          "cues": [
            { "atSec": 20, "text": "第一种气味，哪怕很淡。" },
            { "atSec": 50, "text": "第二种，或记忆里的也行。" },
            { "atSec": 80, "text": "现在只做一次很长的呼气。" },
            { "atSec": 100, "text": "标签可以先关上。你在这张椅子上。" }
          ],
          "adaptive": [{ "when": "arousal>75 at 180s session", "text": "可以只做看到的三样和脚底。够了。" }]
        }
      ]
    },
    {
      "planId": "pmr-release",
